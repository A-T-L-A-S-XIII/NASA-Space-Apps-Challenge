# Dataset served by the API: data/demo (default, real data) or data/fixtures (development only).
TFW_DATA_DIR=data/demo

# Frontend: leave empty to read the static export in frontend/public/api/;
# set to use the FastAPI server during development.
NEXT_PUBLIC_API_BASE=
# Only for hosting under a sub-path (e.g. GitHub Pages project sites).
NEXT_PUBLIC_BASE_PATH=

# Earthdata Login is needed only to download raw products (pipeline). Prefer a
# ~/.netrc entry for urs.earthdata.nasa.gov; never commit credentials.
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Passagens NISAR já processadas, servidas em /api/nisar/* (padrão: Fotos/nisar_taquari_50)
NISAR_DIR=
# Origens liberadas no CORS (o mockup estático roda em :5178)
CORS_ORIGINS=http://localhost:3000,http://localhost:5178
