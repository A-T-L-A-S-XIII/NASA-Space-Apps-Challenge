{
  "$defs": {
    "Access": {
      "properties": {
        "status": {
          "$ref": "#/$defs/AccessStatus"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Time"
        }
      },
      "required": [
        "status",
        "label",
        "basis"
      ],
      "title": "Access",
      "type": "object"
    },
    "AccessStatus": {
      "enum": [
        "interruption_confirmed",
        "section_requiring_verification",
        "isolation_not_demonstrated"
      ],
      "title": "AccessStatus",
      "type": "string"
    },
    "Basis": {
      "enum": [
        "radar",
        "external",
        "inference"
      ],
      "title": "Basis",
      "type": "string"
    },
    "History": {
      "properties": {
        "k": {
          "description": "Acquisitions with candidate water at this cell",
          "title": "K",
          "type": "integer"
        },
        "n": {
          "description": "Acquisitions with a valid observation at this cell",
          "title": "N",
          "type": "integer"
        },
        "total": {
          "description": "All acquisitions in the timeline",
          "title": "Total",
          "type": "integer"
        },
        "by_sensor": {
          "additionalProperties": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "description": "sensor -> (k, n)",
          "title": "By Sensor",
          "type": "object"
        }
      },
      "required": [
        "k",
        "n",
        "total",
        "by_sensor"
      ],
      "title": "History",
      "type": "object"
    },
    "LatestObservation": {
      "properties": {
        "date_id": {
          "title": "Date Id",
          "type": "string"
        },
        "sensor": {
          "enum": [
            "NISAR",
            "Sentinel-1"
          ],
          "title": "Sensor",
          "type": "string"
        },
        "acquisition_time": {
          "format": "date-time",
          "title": "Acquisition Time",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ObservedState"
        }
      },
      "required": [
        "date_id",
        "sensor",
        "acquisition_time",
        "state"
      ],
      "title": "LatestObservation",
      "type": "object"
    },
    "NearestWater": {
      "properties": {
        "date_id": {
          "title": "Date Id",
          "type": "string"
        },
        "distance_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Null when none found within the search radius",
          "title": "Distance M"
        },
        "search_radius_m": {
          "title": "Search Radius M",
          "type": "number"
        }
      },
      "required": [
        "date_id",
        "distance_m",
        "search_radius_m"
      ],
      "title": "NearestWater",
      "type": "object"
    },
    "ObservedState": {
      "enum": [
        "candidate_water",
        "no_candidate_water",
        "no_valid_observation"
      ],
      "title": "ObservedState",
      "type": "string"
    },
    "Statement": {
      "description": "One claim shown on the area card, always with its source and date.",
      "properties": {
        "text": {
          "title": "Text",
          "type": "string"
        },
        "basis": {
          "$ref": "#/$defs/Basis"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Time"
        }
      },
      "required": [
        "text",
        "basis",
        "source",
        "time"
      ],
      "title": "Statement",
      "type": "object"
    }
  },
  "properties": {
    "fixture": {
      "description": "True for DEV FIXTURE data. Never a result.",
      "title": "Fixture",
      "type": "boolean"
    },
    "lat": {
      "title": "Lat",
      "type": "number"
    },
    "lon": {
      "title": "Lon",
      "type": "number"
    },
    "inside_aoi": {
      "title": "Inside Aoi",
      "type": "boolean"
    },
    "latest": {
      "anyOf": [
        {
          "$ref": "#/$defs/LatestObservation"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "history": {
      "anyOf": [
        {
          "$ref": "#/$defs/History"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "nearest_candidate_water": {
      "anyOf": [
        {
          "$ref": "#/$defs/NearestWater"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "access": {
      "anyOf": [
        {
          "$ref": "#/$defs/Access"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "statements": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Statement"
      },
      "title": "Statements",
      "type": "array"
    },
    "disclaimers": {
      "default": [
        "Candidate water-change indicator — not a validated flood map.",
        "Not for evacuation or route decisions.",
        "Based on past and latest radar observations — not a forecast."
      ],
      "items": {
        "type": "string"
      },
      "title": "Disclaimers",
      "type": "array"
    }
  },
  "required": [
    "fixture",
    "lat",
    "lon",
    "inside_aoi"
  ],
  "title": "Exposure",
  "type": "object"
}