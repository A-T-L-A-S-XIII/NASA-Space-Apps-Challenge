{
  "$defs": {
    "Layer": {
      "properties": {
        "kind": {
          "enum": [
            "water",
            "change"
          ],
          "title": "Kind",
          "type": "string"
        },
        "url": {
          "description": "PNG overlay path relative to the API root",
          "title": "Url",
          "type": "string"
        },
        "legend": {
          "items": {
            "$ref": "#/$defs/LegendItem"
          },
          "title": "Legend",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "url",
        "legend"
      ],
      "title": "Layer",
      "type": "object"
    },
    "LegendItem": {
      "properties": {
        "value": {
          "description": "Class value in the grid",
          "title": "Value",
          "type": "integer"
        },
        "label": {
          "title": "Label",
          "type": "string"
        },
        "color": {
          "description": "Hex colour; pattern 'hatch' means rendered with hatching",
          "title": "Color",
          "type": "string"
        },
        "pattern": {
          "default": "solid",
          "enum": [
            "solid",
            "hatch"
          ],
          "title": "Pattern",
          "type": "string"
        }
      },
      "required": [
        "value",
        "label",
        "color"
      ],
      "title": "LegendItem",
      "type": "object"
    }
  },
  "properties": {
    "fixture": {
      "description": "True for DEV FIXTURE data. Never a result.",
      "title": "Fixture",
      "type": "boolean"
    },
    "date_id": {
      "title": "Date Id",
      "type": "string"
    },
    "sensor": {
      "enum": [
        "NISAR",
        "Sentinel-1"
      ],
      "title": "Sensor",
      "type": "string"
    },
    "acquisition_time": {
      "format": "date-time",
      "title": "Acquisition Time",
      "type": "string"
    },
    "bounds": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Bounds",
      "type": "array"
    },
    "threshold_db": {
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "description": "Water threshold applied, in dB",
      "title": "Threshold Db"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/Layer"
      },
      "title": "Layers",
      "type": "array"
    }
  },
  "required": [
    "fixture",
    "date_id",
    "sensor",
    "acquisition_time",
    "bounds",
    "threshold_db",
    "layers"
  ],
  "title": "LayerSet",
  "type": "object"
}