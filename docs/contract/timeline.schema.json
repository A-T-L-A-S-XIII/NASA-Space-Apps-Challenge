{
  "$defs": {
    "TimelineEntry": {
      "properties": {
        "date_id": {
          "description": "Stable id, e.g. 'nisar-20250312T0912'",
          "title": "Date Id",
          "type": "string"
        },
        "acquisition_time": {
          "description": "Acquisition start, UTC",
          "format": "date-time",
          "title": "Acquisition Time",
          "type": "string"
        },
        "sensor": {
          "enum": [
            "NISAR",
            "Sentinel-1"
          ],
          "title": "Sensor",
          "type": "string"
        },
        "product": {
          "description": "Product type and version actually read, e.g. 'GCOV ...'",
          "title": "Product",
          "type": "string"
        },
        "granule_id": {
          "title": "Granule Id",
          "type": "string"
        },
        "valid_fraction": {
          "description": "Share of AOI cells with a valid observation",
          "maximum": 1,
          "minimum": 0,
          "title": "Valid Fraction",
          "type": "number"
        },
        "reference_date_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Previous date of the same sensor used for the change layer; null for the first",
          "title": "Reference Date Id"
        }
      },
      "required": [
        "date_id",
        "acquisition_time",
        "sensor",
        "product",
        "granule_id",
        "valid_fraction",
        "reference_date_id"
      ],
      "title": "TimelineEntry",
      "type": "object"
    }
  },
  "properties": {
    "fixture": {
      "description": "True for DEV FIXTURE data. Never a result.",
      "title": "Fixture",
      "type": "boolean"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "aoi_bbox": {
      "maxItems": 4,
      "minItems": 4,
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "title": "Aoi Bbox",
      "type": "array"
    },
    "entries": {
      "description": "Sorted by acquisition_time ascending",
      "items": {
        "$ref": "#/$defs/TimelineEntry"
      },
      "title": "Entries",
      "type": "array"
    }
  },
  "required": [
    "fixture",
    "generated_at",
    "aoi_bbox",
    "entries"
  ],
  "title": "Timeline",
  "type": "object"
}