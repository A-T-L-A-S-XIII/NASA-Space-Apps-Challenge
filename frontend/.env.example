# Lidas só pelo servidor do Next.js (sem NEXT_PUBLIC_): o navegador nunca as vê.

# URL do FastAPI (ponte /api/auth/* e rewrite de /api em next.config.js)
API_URL=http://localhost:8000

# E-mail da conta de demonstração: com o FastAPI fora do ar, é o único que entra (sessão offline).
# Tem de ser igual ao DEMO_USER_EMAIL do backend. A senha fica só no backend.
DEMO_EMAIL=demo@waterwaltz.dev

# Duração do cookie da sessão, igual ao JWT_EXPIRE_MINUTES do backend
JWT_EXPIRE_MINUTES=1440
