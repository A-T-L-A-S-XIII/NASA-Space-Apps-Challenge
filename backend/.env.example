# Copie para .env e ajuste os valores
APP_NAME="Water Waltz API"
DATABASE_URL=sqlite:///./water_waltz.db

# Origens do frontend liberadas no CORS (separadas por vírgula)
CORS_ORIGINS=http://localhost:3000
# Em produção, inclua o domínio da Vercel: CORS_ORIGINS=http://localhost:3000,https://water-waltz.vercel.app
# Opcional: regex para liberar também os previews da Vercel (deixe vazio para não usar)
CORS_ORIGIN_REGEX=

# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-esta-chave
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Conta governo criada no startup se ainda não existir
SEED_GOV_NAME="Governo RS"
SEED_GOV_EMAIL=governo@waterwaltz.dev
SEED_GOV_PASSWORD=troque-esta-senha

# Catálogo público do ASF DAAC (dados NISAR)
ASF_SEARCH_URL=https://api.daac.asf.alaska.edu/services/search/param
ASF_TIMEOUT_SECONDS=30
ASF_CACHE_TTL_SECONDS=1800

# Índice ONI da NOAA (El Niño / La Niña)
NOAA_ONI_URL=https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt
ENSO_TIMEOUT_SECONDS=15
ENSO_CACHE_TTL_SECONDS=21600

# Modo offline (pitch sem internet): ASF e NOAA vêm de app/data/snapshots/ (gere com scripts/snapshot.py).
# Com false, os snapshots só são usados se a fonte ao vivo falhar (a resposta vem com live: false).
OFFLINE_MODE=false

# Login Earthdata (https://urs.earthdata.nasa.gov), usado só por scripts/process_nisar.py
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=
