# Copie para .env e ajuste os valores
APP_NAME="Water Waltz API"
DATABASE_URL=sqlite:///./water_waltz.db

# Origens liberadas no CORS (separadas por vírgula). Quem chama a API é o servidor do Next.js, não o
# navegador; libere só o Next local e, em produção, a URL do Next.
CORS_ORIGINS=http://localhost:3000
# Em produção, inclua a URL do Next: CORS_ORIGINS=http://localhost:3000,https://water-waltz.vercel.app
# Opcional: regex para liberar também os previews da Vercel (deixe vazio para não usar)
CORS_ORIGIN_REGEX=

# Gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=troque-esta-chave
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Conta governo criada no startup se ainda não existir
SEED_GOV_NAME="Governo RS"
SEED_GOV_EMAIL=governo@waterwaltz.dev
SEED_GOV_PASSWORD=troque-esta-senha

# Catálogo público do ASF DAAC (dados NISAR)
ASF_SEARCH_URL=https://api.daac.asf.alaska.edu/services/search/param
ASF_TIMEOUT_SECONDS=30
ASF_CACHE_TTL_SECONDS=1800

# Índice ONI da NOAA (El Niño / La Niña)
NOAA_ONI_URL=https://www.cpc.ncep.noaa.gov/data/indices/oni.ascii.txt
ENSO_TIMEOUT_SECONDS=15
ENSO_CACHE_TTL_SECONDS=21600

# Previsão do tempo da Open-Meteo (sem chave). Cache de 30 min; depois de uma falha, espera antes de tentar de novo
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
FORECAST_TIMEOUT_SECONDS=15
FORECAST_CACHE_TTL_SECONDS=1800
FORECAST_RETRY_SECONDS=300

# Busca de bairros no Nominatim (OpenStreetMap). A política de uso pede User-Agent que identifique o app
# e no máximo 1 pedido por segundo. Os municípios vêm da malha local do IBGE (sem rede).
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT="WaterWaltz/0.1 (+https://github.com/A-T-L-A-S-XIII/NASA-Space-Apps-Challenge)"
NOMINATIM_MIN_INTERVAL_SECONDS=1
PLACES_TIMEOUT_SECONDS=15
PLACES_CACHE_TTL_SECONDS=86400

# Passagens NISAR já processadas (catalogo.json + pastas img_*). Vazio = Fotos/nisar_taquari_50 na raiz do repo.
# Não confundir com NISAR_DIR, que guarda as manchas de scripts/process_nisar.py.
# NISAR_FOTOS_DIR=
# Malha municipal do IBGE (gerada por pipeline/build_vale_municipios.py). Vazio = app/data/vale_municipios.geojson
# MUNICIPALITIES_FILE=

# Modo offline (pitch sem internet): ASF e NOAA vêm de app/data/snapshots/ (gere com scripts/snapshot.py).
# Com false, os snapshots só são usados se a fonte ao vivo falhar (a resposta vem com live: false).
# Com true, a previsão (Open-Meteo) e a busca de bairros (Nominatim) também não são consultadas.
OFFLINE_MODE=false

# Login Earthdata (https://urs.earthdata.nasa.gov), usado só por scripts/process_nisar.py
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# Projeto do Google Cloud ligado ao Earth Engine, usado só por scripts/process_sentinel1.py
# (antes, rode `earthengine authenticate` uma vez)
EE_PROJECT=
